# Copy this file to ".env" and fill in real values. ".env" is git-ignored
# on purpose — it holds secrets and must never be committed.

# --- Database ---------------------------------------------------------------
# A Postgres connection string. The quickest free option is Neon
# (https://neon.tech) or Railway (https://railway.app):
#   1. Create a free project/database.
#   2. Copy the connection string it gives you and paste it below.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- Admin login (used only by `npm run db:seed`, see prisma/seed.ts) ------
# The very first admin account is created from these two values the first
# time you run the seed script. Change the password after logging in for
# real by re-running the seed script with new values (it's safe to re-run).
SEED_ADMIN_EMAIL="founder@example.com"
SEED_ADMIN_PASSWORD="change-this-password"

# --- Image storage (Cloudinary) ---------------------------------------------
# Free account at https://cloudinary.com. The dashboard shows a single
# "API Environment variable" in exactly this format — copy it as-is.
CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"
# Used client-side (e.g. next/image remote loader), safe to expose.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="<cloud_name>"
NEXT_PUBLIC_CLOUDINARY_API_KEY="<api_key>"
