# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template — this one SHOULD be committed so anyone cloning
# the repo knows which variables they need to set.
!.env.example

# vercel
.vercel

# images uploaded through the admin panel at runtime (see src/lib/storage.ts)
# — these belong on disk/in cloud storage, not in git.
/public/uploads


# typescript
*.tsbuildinfo
next-env.d.ts
